# 환경 변수 견본. 값은 비워 두었고, 실제 파일은 모두 .gitignore 대상이다.
# 파일마다 읽는 곳이 다르므로 아래 묶음을 해당 파일 이름으로 나눠 만든다(docs/운영_안내.md 참고).

# ── .env.development.local : npm run dev 가 읽는다(로컬 Supabase, `supabase status`로 확인)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=            # npm run push:setup 이 채운다

# ── .env.production.local : npm run build 가 읽는다(운영 Supabase)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=         # scripts/push-prod-setup.mjs 가 서버 기능 비밀로 등록한다
# PUSH_CRON_SECRET=

# ── .env.phonetest.local : npm run phone:test 가 만든다(로컬 DB를 쓰는 휴대폰 시험 빌드)
# VITE_SUPABASE_SAME_ORIGIN=1

# ── .env.local : 검증 스크립트가 읽는다
# 아래 두 값은 이 저장소의 마이그레이션에 해시로 들어 있는 예시 코드다. 운영에서는 다른 코드로 바꾼다(docs/운영_안내.md).
TRAINER_CODE=MEALNOTE-TRAINER
ADMIN_CODE=MEALNOTE-ADMIN
# 운영에서 직접 써 볼 테스트 계정(닉네임·PIN·복구 질문 번호·답)
TEST_TRAINER_NICK=
TEST_TRAINER_PIN=
TEST_TRAINER_RECOVERY_Q=
TEST_TRAINER_RECOVERY_ANSWER=
TEST_MEMBER_NICK=
TEST_MEMBER_PIN=
TEST_MEMBER_RECOVERY_Q=
TEST_MEMBER_RECOVERY_ANSWER=
PHONE_TEST_TRAINER_NICK=
PHONE_TEST_TRAINER_PIN=

# ── supabase/functions/.env : 로컬 서버 기능(send-push)이 읽는다. npm run push:setup 이 만든다
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PUSH_CRON_SECRET=
